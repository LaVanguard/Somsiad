# =============================================================================
# Law Advisor - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Which settings module to use
# Options: development (local), production (Railway/Heroku)
ENVIRONMENT=development

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
# Generate new secret key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode - MUST be False in production!
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
# Development: localhost,127.0.0.1
# Production: your-app.railway.app,yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE CONFIGURATION (Production Only)
# =============================================================================
# Railway/Heroku will auto-provide DATABASE_URL
# For manual configuration, use one of:

# Option 1: DATABASE_URL (Railway/Heroku standard)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Option 2: Individual Supabase PostgreSQL settings
# SUPABASE_DB_HOST=db.xxx.supabase.co
# SUPABASE_DB_PASSWORD=your-supabase-password
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PORT=5432

# =============================================================================
# OPENAI API (Required for RAG)
# =============================================================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# SUPABASE (Required for Vector Storage)
# =============================================================================
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# =============================================================================
# EMAIL CONFIGURATION (Optional - Production)
# =============================================================================
# For error notifications to admins
# ADMIN_EMAIL=admin@example.com
# SERVER_EMAIL=noreply@somsiad.pl

# For sending emails via SMTP
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
